# Copy this file to .env and fill in local values. Never commit .env.
# The service reads these from the environment; .env is only a local convenience.

KEELTUBE_CORE_ADDR=127.0.0.1:8080
KEELTUBE_WORKER_ADDR=127.0.0.1:8083
KEELTUBE_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
KEELTUBE_CORS_ORIGINS=http://localhost:3000

# Dev-only identity fallback. Leave disabled unless you explicitly need the
# fixed dev principal. Never enable this on a shared or public deployment.
KEELTUBE_DEV_ACTOR_ID=usr_demo
# KEELTUBE_DEV_ACTOR_TOKEN=
# KEELTUBE_AUTH_ALLOW_DEV=false

# Optional override for the seeded demo playback URL.
# KEELTUBE_DEMO_MEDIA_URL=http://localhost:3000/media/ksKCMmvOxwQ.mp4
KEELTUBE_WEB_PUBLIC_URL=http://localhost:3000
KEELTUBE_APP_URL=http://localhost:3000
# Optional logo override. Defaults to the embedded KeelTube horizontal lockup.
KEELTUBE_EMAIL_LOGO_URL=
# Optional dark-mode logo override. Defaults to the embedded dark lockup.
KEELTUBE_EMAIL_LOGO_DARK_URL=

# Optional demo account. Set both or neither. Never use a shared password.
KEELTUBE_SEED_DEMO_EMAIL=
KEELTUBE_SEED_DEMO_PASSWORD=

# Transactional email. Credentials belong here, never in code.
# Supported providers: smtp, mailtrap, mailgun, log.
KEELTUBE_MAIL_PROVIDER=log
KEELTUBE_MAIL_FROM="KeelTube <no-reply@keeltube.local>"
KEELTUBE_MAIL_TIMEOUT_SECONDS=10

# SMTP (used when KEELTUBE_MAIL_PROVIDER=smtp)
KEELTUBE_SMTP_HOST=
KEELTUBE_SMTP_PORT=587
KEELTUBE_SMTP_USERNAME=
KEELTUBE_SMTP_PASSWORD=
KEELTUBE_SMTP_SECURITY=starttls

# Provider API (used when KEELTUBE_MAIL_PROVIDER=mailtrap or mailgun)
# KEELTUBE_MAIL_API_KEY=
# KEELTUBE_MAIL_DOMAIN=
# KEELTUBE_MAIL_BASE_URL=

# Session cookie transport. TTLs, attempt limits, rate limits, and
# code exposure are fixed policy constants in the service code.
KEELTUBE_SESSION_COOKIE=keeltube_session
KEELTUBE_CSRF_COOKIE=keeltube_csrf
KEELTUBE_COOKIE_SECURE=false
# KEELTUBE_COOKIE_DOMAIN=

# Discovery and semantic retrieval. Leave KEELTUBE_EMBEDDINGS_URL unset to use
# the deterministic in-process embedder. Set it to the keel-embeddings service
# for semantic feed and Explore recommendations.
KEELTUBE_EMBEDDINGS_URL=
KEELTUBE_EMBEDDINGS_TOKEN=local-dev-embeddings-token
# hash-embedder matches the in-process fallback; use BAAI/bge-small-en-v1.5 with the real service.
KEELTUBE_EMBEDDINGS_MODEL=hash-embedder
KEELTUBE_EMBEDDINGS_DIMENSIONS=384
KEELTUBE_EMBEDDINGS_TIMEOUT_SECONDS=30

# Watch telemetry retention. Raw view sessions/events and discovery events older than
# this many days are pruned. Daily creator analytics aggregates are retained.
KEELTUBE_ANALYTICS_RETENTION_DAYS=90

# Optional service-to-service token for POST /internal/v1/notifications. Leave unset
# to disable the internal notification ingest route entirely.
# KEELTUBE_INTERNAL_TOKEN=local-dev-internal-token

# Creator moderation gateway. Core mints short-lived HS256 OIDC-style claims
# with the real actor and channel. The secret must be at least 32 characters
# and must match keel-moderation's KEELTUBE_OIDC_HMAC_SECRET.
KEELTUBE_MODERATION_URL=http://127.0.0.1:8082
KEELTUBE_MODERATION_CLAIMS_SECRET=local-dev-moderation-claims-secret
KEELTUBE_MODERATION_CLAIMS_ISSUER=keel-core
KEELTUBE_MODERATION_CLAIMS_AUDIENCE=keel-moderation
KEELTUBE_MODERATION_CLAIMS_TTL_SECONDS=60
# Legacy static token mode; used only when the claims secret is unset.
# KEELTUBE_MODERATION_TOKEN=
KEELTUBE_MODERATION_TIMEOUT_SECONDS=10
# Server-side token for viewer reports. Must match moderation's
# KEELTUBE_SIGNAL_INGEST_TOKEN. Leave unset to disable POST /api/v1/reports.
# KEELTUBE_MODERATION_SIGNAL_TOKEN=local-dev-signal-token

# Creator Studio media engine. S3-compatible object storage only; there is no
# local filesystem fallback. Leave the bucket empty to disable upload routes.
# Playback is served through core with short-lived presigned GET redirects, so
# the bucket must remain private.
KEELTUBE_MEDIA_S3_BUCKET=
KEELTUBE_MEDIA_S3_REGION=us-east-1
# Set for MinIO, Cloudflare R2, or another S3-compatible endpoint.
KEELTUBE_MEDIA_S3_ENDPOINT=
# Public endpoint used only to sign browser-facing URLs. Set this when the
# internal endpoint is not reachable by the browser (for example MinIO on a
# Compose network); the internal endpoint is still used for S3 operations.
# KEELTUBE_MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:9000
# Optional static credentials. Leave empty to use the AWS default credential chain.
KEELTUBE_MEDIA_S3_ACCESS_KEY_ID=
KEELTUBE_MEDIA_S3_SECRET_ACCESS_KEY=
KEELTUBE_MEDIA_S3_SESSION_TOKEN=
# KEELTUBE_MEDIA_S3_USE_PATH_STYLE=true
KEELTUBE_MEDIA_S3_PREFIX=media
# Public core base URL used to build playback URLs.
KEELTUBE_MEDIA_PUBLIC_URL=http://localhost:8080
KEELTUBE_MEDIA_PRESIGN_SECONDS=900
KEELTUBE_MEDIA_UPLOAD_TTL_SECONDS=86400
KEELTUBE_MEDIA_PART_SIZE_MB=64
KEELTUBE_MEDIA_MAX_UPLOAD_MB=20480
# Delete successful source objects after processing. Set true to keep originals for export.
KEELTUBE_MEDIA_RETAIN_SOURCE=false
# Completed job rows are pruned by the worker after this many days.
KEELTUBE_MEDIA_JOB_RETENTION_DAYS=7
KEELTUBE_MEDIA_MAX_DURATION_SECONDS=14400
KEELTUBE_MEDIA_MIN_DURATION_SECONDS=1
KEELTUBE_MEDIA_WORKERS=2
KEELTUBE_MEDIA_POLL_SECONDS=2
KEELTUBE_MEDIA_JOB_TIMEOUT_SECONDS=3600
KEELTUBE_MEDIA_JOB_LEASE_SECONDS=1800
KEELTUBE_MEDIA_FFMPEG=ffmpeg
KEELTUBE_MEDIA_FFPROBE=ffprobe
KEELTUBE_MEDIA_WORK_DIR=
KEELTUBE_MEDIA_MAX_RENDITION_HEIGHT=1080
KEELTUBE_MEDIA_HLS_SEGMENT_SECONDS=6
KEELTUBE_MEDIA_ALLOWED_EXTENSIONS=.mp4,.mov,.m4v,.mkv,.webm,.avi
KEELTUBE_MEDIA_ALLOWED_CONTENT_TYPES=video/mp4,video/quicktime,video/x-m4v,video/x-matroska,video/webm,video/x-msvideo,application/octet-stream
# Comma-separated metadata terms that block an upload.
KEELTUBE_MEDIA_POLICY_TERMS=
# Optional external copyright/policy scanner. It receives a JSON ScanInput and
# must return {"verdict":"allow|review|block","findings":[...]}. Scanner errors
# fail closed and are retried by the media worker.
KEELTUBE_MEDIA_SCANNER_URL=
KEELTUBE_MEDIA_SCANNER_TOKEN=
KEELTUBE_MEDIA_SCANNER_TIMEOUT_SECONDS=10



# Stripe Connect billing and settlement. Fill in test-mode credentials.
# Leave KEELTUBE_STRIPE_SECRET_KEY empty to disable creator onboarding and
# payout settlement. The webhook route requires KEELTUBE_STRIPE_WEBHOOK_SECRET.
KEELTUBE_STRIPE_SECRET_KEY=
KEELTUBE_STRIPE_PUBLISHABLE_KEY=
KEELTUBE_STRIPE_WEBHOOK_SECRET=
KEELTUBE_STRIPE_API_BASE_URL=https://api.stripe.com
# KEELTUBE_STRIPE_API_VERSION=
KEELTUBE_STRIPE_TIMEOUT_SECONDS=20
KEELTUBE_STRIPE_CONNECT_COUNTRY=US
KEELTUBE_STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/studio/monetization?stripe=refresh
KEELTUBE_STRIPE_CONNECT_RETURN_URL=http://localhost:3000/studio/monetization?stripe=return
KEELTUBE_STRIPE_MIN_SETTLEMENT_CENTS=100
KEELTUBE_STRIPE_CURRENCY=usd
KEELTUBE_STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ActivityPub federation. Leave the domain unset to disable federation.
# KEELTUBE_FEDERATION_DOMAIN=keeltube.example
# KEELTUBE_FEDERATION_BASE_URL=https://keeltube.example
# KEELTUBE_FEDERATION_ACTOR_ID=instance
# KEELTUBE_FEDERATION_POLICY_VERSION=demo-0.1
# KEELTUBE_FEDERATION_TIMEOUT_SECONDS=10
# KEELTUBE_FEDERATION_DELIVERY_LEASE_SECONDS=300
# Local testing only: allow remote actors on private/loopback addresses.
# KEELTUBE_FEDERATION_ALLOW_PRIVATE=false

# Social sign-in. Providers stay disabled until a client ID is set. Register
# <KEELTUBE_SOCIAL_CALLBACK_BASE_URL>/api/v1/auth/social/<provider>/callback
# with each provider. Never commit real provider secrets.
KEELTUBE_SOCIAL_CALLBACK_BASE_URL=http://localhost:8080
# KEELTUBE_GOOGLE_CLIENT_ID=
# KEELTUBE_GOOGLE_CLIENT_SECRET=
# KEELTUBE_APPLE_CLIENT_ID=
# KEELTUBE_APPLE_CLIENT_SECRET=
# KEELTUBE_APPLE_TEAM_ID=
# KEELTUBE_APPLE_KEY_ID=
# KEELTUBE_APPLE_PRIVATE_KEY_PATH=
# KEELTUBE_X_CLIENT_ID=
# KEELTUBE_X_CLIENT_SECRET=

# Optional cross-encoder reranker for semantic search. Unset uses the
# deterministic lexical reranker.
# KEELTUBE_RERANKER_URL=http://127.0.0.1:9001/rerank
# KEELTUBE_RERANKER_TOKEN=
# KEELTUBE_RERANKER_MODEL=cross-encoder
